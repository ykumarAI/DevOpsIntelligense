# Copy to .env to override defaults.
# Per-user data directory for the SQLite DB and config.
# Defaults to a ".devops" folder in your home directory (like .aws / .m2),
# e.g. C:\Users\<you>\.devops
# DASHBOARD_DATA_DIR=C:\Users\<you>\.devops

# Database (defaults to a SQLite file inside the data directory above).
# Set this only to point at an external DB (Postgres, etc.).
# DATABASE_URL=sqlite:///./devops_dashboard.db

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default AWS region used when an account does not specify one
DEFAULT_AWS_REGION=us-east-1
